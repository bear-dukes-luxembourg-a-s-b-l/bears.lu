---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}

const { title, subtitle, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <section class="mx-auto w-full max-w-[1240px] px-8 pb-4 pt-14">
    <h1 class="font-display text-[42px]">{title}</h1>
    {subtitle && <p class="mt-2 max-w-[640px] text-[15px] text-tan-soft">{subtitle}</p>}
  </section>
  <section class="mx-auto w-full max-w-[760px] px-8 pb-20 pt-6 text-[15px] leading-relaxed text-tan-soft [&_h2]:font-display [&_h2]:mt-9 [&_h2]:mb-3 [&_h2]:text-[20px] [&_h2]:text-cream [&_h3]:mt-7 [&_h3]:mb-2 [&_h3]:text-[16px] [&_h3]:font-bold [&_h3]:text-cream [&_a]:text-gold [&_a]:font-semibold [&_ul]:list-disc [&_ul]:pl-5 [&_p]:mb-4">
    <slot />
  </section>
</BaseLayout>
