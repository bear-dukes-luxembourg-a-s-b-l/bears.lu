---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { postUrl } from '../../lib/posts';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (d: Date) => d.toLocaleDateString('en', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="News" description="All the news we posted so far.">
  <section class="mx-auto flex w-full max-w-[1240px] flex-wrap items-end justify-between gap-5 px-8 py-14">
    <div>
      <div class="mb-1 text-xs font-extrabold uppercase tracking-wide text-gold">The community's journal</div>
      <h1 class="font-display text-[42px]">News</h1>
    </div>
    <a
      href="/feed.xml"
      class="inline-flex items-center gap-2 rounded-full border border-border px-4 py-2.5 text-sm font-bold text-tan transition-colors hover:border-gold hover:text-gold"
    >
      <Icon name="rss" /> Subscribe
    </a>
  </section>

  <section class="mx-auto grid max-w-[1240px] grid-cols-1 gap-6 px-8 pb-20 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
      <a href={postUrl(post)} class="overflow-hidden rounded-2xl border border-border bg-surface">
        <div class="aspect-[16/10] overflow-hidden bg-surface-alt">
          {post.data.image && (
            <Image
              src={post.data.image}
              alt=""
              width={480}
              height={300}
              class="h-full w-full object-cover"
            />
          )}
        </div>
        <div class="p-4.5">
          {post.data.categories[0] && (
            <span class="rounded-full bg-gold px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wide text-ink">
              {post.data.categories[0]}
            </span>
          )}
          <div class="mt-2.5 text-[15px] font-extrabold leading-snug">{post.data.title}</div>
          <div class="mt-2 flex items-center gap-1.5 text-xs text-tan">
            <Icon name="calendar" /> {formatDate(post.data.date)}
          </div>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
