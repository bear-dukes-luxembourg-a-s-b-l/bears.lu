---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo.png';
import { postUrl } from '../lib/posts';
import Newsletter from '../components/Newsletter.astro';
import EventCard from '../components/EventCard.astro';

const bearPride = (await getEntry('bearPrideConfig', 'bearpride'))!.data;

// General community events (not the Bear Pride week's own programme, which
// lives on /bear-pride and comes from the `events` collection).
const upcoming = (await getCollection('generalEvents'))
  .map((entry) => entry.data)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);

const yearNumber = (year: number | string) => parseInt(String(year), 10) || 0;
const mrbears = (await getCollection('mrbears')).sort(
  (a, b) => yearNumber(b.data.year) - yearNumber(a.data.year)
);
// A titleholder with spotlight:true gets a temporary "Congratulations"
// banner above the hero — turned on by an editor right after the election,
// then off again later. If more than one is somehow flagged, show the
// most recent.
const spotlightMrBear = mrbears.find((mister) => mister.data.spotlight);

// The asbl's own year-round partners — separate from the Bear Pride
// edition's gold/silver/media sponsors shown on /bear-pride.
const sponsorLogos = (await getCollection('generalSponsors')).map((entry) => entry.data);

const latestPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const formatPostDate = (d: Date) => d.toLocaleDateString('en', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="Home" description="The first bear community in Luxembourg.">
  <!-- Winner spotlight -->
  {spotlightMrBear && (
    <section
      id="winner-spotlight"
      data-spotlight-id={spotlightMrBear.id}
      class="relative overflow-hidden border-b border-border-soft"
    >
      <div
        class="absolute inset-0 opacity-20"
        style="background: repeating-linear-gradient(115deg, var(--color-rust) 0 50px, var(--color-rust-light) 50px 100px, var(--color-gold) 100px 150px, var(--color-slate) 150px 190px, var(--color-black-flag) 190px 230px, var(--color-red-flag) 230px 270px, var(--color-blue-flag) 270px 310px);"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-ink/55 to-ink/92"></div>

      <button
        id="winner-spotlight-dismiss"
        aria-label="Dismiss"
        class="absolute right-6 top-4 z-10 flex h-8 w-8 items-center justify-center rounded-full border border-border bg-ink/50 text-tan"
      >
        <Icon name="x" />
      </button>

      <div class="relative mx-auto flex max-w-[900px] flex-col items-center gap-3.5 px-8 py-13 text-center">
        <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-wide text-gold">
          <Icon name="crown" /> New Mr. Bear Luxembourg
        </div>

        {spotlightMrBear.data.image ? (
          <Image
            src={spotlightMrBear.data.image}
            alt=""
            width={264}
            height={264}
            class="h-[132px] w-[132px] rounded-full border-[3px] border-gold object-cover p-1"
          />
        ) : (
          <div class="flex h-[132px] w-[132px] items-center justify-center rounded-full border-[3px] border-gold text-[11px] text-muted">
            photo coming
          </div>
        )}

        <h2 class="font-display text-[40px] leading-[1.05]">{spotlightMrBear.data.name}</h2>
        <p class="max-w-[560px] text-sm text-cream-soft">{spotlightMrBear.data.description}</p>

        <div class="mt-1.5 flex flex-wrap justify-center gap-4">
          <a href="/mr-bear" class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3.5 text-[15px] font-bold text-ink">
            View full profile →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border-soft">
    <div
      class="absolute inset-0 opacity-15"
      style="background: repeating-linear-gradient(115deg, var(--color-rust) 0 60px, var(--color-rust-light) 60px 120px, var(--color-gold) 120px 180px, var(--color-slate) 180px 230px, var(--color-black-flag) 230px 280px, var(--color-red-flag) 280px 330px, var(--color-blue-flag) 330px 380px);"
    ></div>
    <div class="relative mx-auto flex max-w-[1240px] flex-col items-center gap-5 px-8 py-20 text-center">
      <Image src={logo} alt="" width={154} height={256} loading="eager" class="h-32 w-auto drop-shadow-xl" />
      <div class="font-display text-xs tracking-[1.5px] text-gold">LGBTQ+ Bear community · since 2015</div>
      <h1 class="font-display max-w-[760px] text-[44px] leading-[1.05] sm:text-[56px]">
        The bear community of Luxembourg
      </h1>
      <p class="max-w-[560px] text-lg text-tan-soft">
        Monthly get-togethers, bear events and the annual Bear Pride in Luxembourg City.
        Grab your boots, join the pack.
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-4">
        {bearPride.enabled && (
          <a href="/bear-pride" class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3.5 text-[15px] font-bold text-ink">
            Bear Pride 2026 →
          </a>
        )}
        <a
          href="#events"
          class:list={[
            'inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-bold',
            bearPride.enabled ? 'border-2 border-cream text-cream' : 'bg-gold text-ink',
          ]}
        >
          See upcoming events
        </a>
      </div>
    </div>
  </section>

  <!-- Hub: events + news -->
  <section id="events" class="mx-auto grid max-w-[1240px] grid-cols-1 gap-8 px-8 py-16 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="mb-5 flex items-baseline justify-between">
        <h2 class="font-display flex items-center gap-2 text-2xl">
          <Icon name="paw" class="text-gold" /> Upcoming events
        </h2>
        <a href="/calendar" class="text-sm font-bold text-gold">See all events →</a>
      </div>
      <div class="flex flex-col gap-3.5">
        {upcoming.length > 0 ? (
          upcoming.map((event, i) => <EventCard event={event} index={i} />)
        ) : (
          <div class="rounded-2xl border border-dashed border-border p-5 text-sm text-tan">
            No events scheduled right now — follow our{' '}
            <a href="https://www.facebook.com/groups/beardukes" class="font-bold text-gold">Facebook group</a>{' '}
            to know when the next one's up.
          </div>
        )}
        <a
          href="/calendar.ics"
          class="rounded-xl border border-dashed border-border p-2.5 text-center text-sm font-bold text-tan"
        >
          + Add this calendar to my agenda
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-7 lg:col-span-5">
      <div>
        <h2 class="font-display mb-5 flex items-center gap-2 text-2xl">
          <Icon name="newspaper" class="text-gold" /> Latest news
        </h2>
        <div class="flex flex-col gap-3.5">
          {latestPosts.map((post) => (
            <a href={postUrl(post)} class="flex gap-3.5">
              {post.data.image ? (
                <Image
                  src={post.data.image}
                  alt=""
                  width={144}
                  height={144}
                  class="h-[72px] w-[72px] flex-none rounded-lg object-cover"
                />
              ) : (
                <div class="h-[72px] w-[72px] flex-none rounded-lg bg-surface-alt" />
              )}
              <div>
                <div class="text-sm font-bold leading-tight">{post.data.title}</div>
                <div class="mt-1 text-xs text-tan">{formatPostDate(post.data.date)}</div>
              </div>
            </a>
          ))}
        </div>
        <a href="/news" class="mt-3.5 block rounded-xl border border-dashed border-border p-2.5 text-center text-sm font-bold text-tan">
          All the news
        </a>
      </div>

      <Newsletter />
    </div>
  </section>

  <!-- Mr Bear mosaic -->
  <section class="border-y border-border-soft bg-surface-alt py-16">
    <div class="mx-auto max-w-[1240px] px-8">
      <div class="mb-7 flex items-baseline justify-between">
        <div>
          <div class="mb-2 text-xs font-extrabold uppercase tracking-wide text-gold">Since 2015</div>
          <h2 class="font-display text-2xl">The Mr. Bear Luxembourg titleholders</h2>
        </div>
        <a href="/mr-bear" class="text-sm font-bold text-gold">See every Mister →</a>
      </div>
      <div class="flex gap-7 overflow-x-auto pb-2">
        {mrbears.map((mister) => (
          <div class="w-[150px] flex-none text-center">
            {mister.data.image ? (
              <Image
                src={mister.data.image}
                alt={mister.data.name}
                width={300}
                height={300}
                class="h-[150px] w-[150px] rounded-full border-[3px] border-gold object-cover"
              />
            ) : (
              <div class="flex h-[150px] w-[150px] items-center justify-center rounded-full border-[3px] border-dashed border-border bg-surface text-[11px] text-muted">
                photo coming
              </div>
            )}
            <div class="mt-2.5 text-sm font-bold">{mister.data.name}</div>
            <div class="text-xs text-tan">Mr. Bear {mister.data.year}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sponsors -->
  {sponsorLogos.length > 0 && (
    <section class="mx-auto max-w-[1240px] px-8 py-14 text-center">
      <div class="mb-5 text-xs font-extrabold uppercase tracking-wide text-gold">With the support of</div>
      <div class="flex flex-wrap items-center justify-center gap-9 opacity-80">
        {sponsorLogos.map((sponsor) => (
          <a href={sponsor.url} class="flex h-[34px] items-center rounded-lg bg-surface px-5 text-sm font-bold text-tan">
            {sponsor.name}
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

{spotlightMrBear && (
  <script>
    // Lets a visitor dismiss the winner spotlight for themselves; keyed by
    // the entry's id so a newly spotlighted titleholder shows again even
    // if an older one was dismissed.
    const section = document.getElementById('winner-spotlight');
    const key = `dismissed-spotlight-${section?.dataset.spotlightId}`;
    if (section && localStorage.getItem(key)) {
      section.remove();
    }
    document.getElementById('winner-spotlight-dismiss')?.addEventListener('click', () => {
      localStorage.setItem(key, '1');
      section?.remove();
    });
  </script>
)}
