---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
---
<PageLayout title="Payment Cancelled">
  <div class="not-prose flex gap-4 rounded-2xl border border-danger-border bg-danger-bg p-6">
    <Icon name="x" class="mt-1 flex-none text-danger" />
    <div>
      <div class="font-display text-[16px] text-cream">Woops, something went wrong</div>
      <p class="mt-2 text-[14px] text-tan-soft">A few reasons can explain the error:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-[14px] text-tan-soft">
        <li>You cancelled the payment during the 3D Secure procedure. The payment was automatically cancelled — you'll need to retry it manually.</li>
        <li>You decided to abort the payment. If so, we'd be glad to <a class="text-gold font-semibold" href="/contact">know why</a>.</li>
        <li>Your card was declined by your bank. This can happen even when there are enough funds on the account — banks sometimes flag unusual transactions.</li>
      </ul>
      <p class="mt-3 text-[14px] text-tan-soft">In any case, feel free to <a class="text-gold font-semibold" href="/contact">contact us</a> if you have any questions.</p>
    </div>
  </div>
</PageLayout>
