---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
---
<PageLayout title="Payment Successful" subtitle="Thank you very much for your support">
  <div class="not-prose flex gap-4 rounded-2xl border border-[#2e5a3a] bg-[#152318] p-6">
    <Icon name="check" class="mt-1 flex-none text-[#5ec27a]" />
    <div>
      <div class="font-display text-[16px] text-cream">Payment went well!</div>
      <p class="mt-2 text-[14px] text-tan-soft">
        Your order will be sent out soon (you'll get an email about it from us). Thanks again!
      </p>
    </div>
  </div>
</PageLayout>
