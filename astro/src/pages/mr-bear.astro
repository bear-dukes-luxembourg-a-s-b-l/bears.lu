---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const yearNumber = (year: number | string) => parseInt(String(year), 10) || 0;
const mrbears = (await getCollection('mrbears')).sort(
  (a, b) => yearNumber(b.data.year) - yearNumber(a.data.year)
);

const bearPride = (await getEntry('bearPrideConfig', 'bearpride'))!.data;
---
<BaseLayout title="Mr. Bear Luxembourg" description="Those who have worn the title over the years.">
  <section class="mx-auto max-w-[1240px] px-8 py-14">
    <div class="mb-2 text-xs font-extrabold uppercase tracking-wide text-gold">Since 2015</div>
    <h1 class="font-display flex items-center gap-2 text-[42px]">
      <Icon name="crown" class="text-gold" /> Mr. Bear Luxembourg
    </h1>
    <p class="mt-2 max-w-[640px] text-[15px] text-tan-soft">Those who have worn the title over the years.</p>
  </section>

  {bearPride.application_open && (
    <section class="mx-auto max-w-[1240px] px-8 pb-2">
      <div class="flex flex-wrap items-center justify-between gap-5 rounded-2xl border border-gold bg-surface p-6">
        <div>
          <div class="text-base font-extrabold">Want to be the next one?</div>
          <div class="mt-1 text-sm text-tan">Mr. Bear Luxembourg applications are open right now.</div>
        </div>
        <a href="/bear-pride#candidats" class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3.5 text-[15px] font-bold text-ink">
          <Icon name="crown" /> See the candidates
        </a>
      </div>
    </section>
  )}

  <section class="mx-auto flex max-w-[1240px] flex-col gap-5 px-8 py-14">
    {mrbears.map((mister) => (
      <div class="flex flex-col gap-6 rounded-2xl border border-border bg-surface p-7 sm:flex-row">
        {mister.data.image ? (
          <Image
            src={mister.data.image}
            alt={mister.data.name}
            width={320}
            height={320}
            class="h-40 w-40 flex-none rounded-full object-cover"
          />
        ) : (
          <div class="flex h-40 w-40 flex-none items-center justify-center rounded-full border-2 border-dashed border-border bg-ink text-center text-xs text-muted">
            photo coming
          </div>
        )}
        <div class="flex-1">
          <div class="mb-2 flex items-baseline gap-3">
            <span class="font-display text-xl">{mister.data.name}</span>
            <span class="text-xs font-extrabold uppercase tracking-wide text-gold">Mr. Bear {mister.data.year}</span>
          </div>
          <p class="text-sm leading-relaxed text-tan-soft">{mister.data.description}</p>
          {(mister.data.social?.instagram || mister.data.social?.facebook || mister.data.social?.twitter) && (
            <div class="mt-4 flex gap-2">
              {mister.data.social?.instagram && (
                <a href={mister.data.social.instagram} aria-label={`${mister.data.name} on Instagram`} class="flex h-[34px] w-[34px] items-center justify-center rounded-full border border-cream">
                  <Icon name="ig" />
                </a>
              )}
              {mister.data.social?.facebook && (
                <a href={mister.data.social.facebook} aria-label={`${mister.data.name} on Facebook`} class="flex h-[34px] w-[34px] items-center justify-center rounded-full border border-cream">
                  <Icon name="fb" />
                </a>
              )}
              {mister.data.social?.twitter && (
                <a href={mister.data.social.twitter} aria-label={`${mister.data.name} on Twitter`} class="flex h-[34px] w-[34px] items-center justify-center rounded-full border border-cream">
                  <Icon name="twitter" />
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
