---
import Icon from './Icon.astro';
---
<div class="rounded-2xl border border-border bg-surface p-6">
  <div class="mb-1 flex items-center gap-2 font-extrabold">
    <Icon name="mail" class="text-gold" /> Newsletter
  </div>
  <div class="mb-3.5 text-sm text-tan">Events and news, straight to your inbox.</div>
  <div class="newsletter-embed">
    <script
      async
      src="https://eomail5.com/form/b9d8f35c-41a1-11ec-96e5-06b4694bee2a.js"
      data-form="b9d8f35c-41a1-11ec-96e5-06b4694bee2a"
    ></script>
  </div>
</div>

<style is:global>
  /*
   * The EmailOctopus embed script injects its own real form elements
   * (not an iframe) with these vendor class names, asynchronously after
   * load — Astro's scoped styles can't reach elements added that way, so
   * this is deliberately global, scoped by the .newsletter-embed wrapper.
   */
  .newsletter-embed .main-form {
    display: flex !important;
    gap: 8px;
    align-items: center !important;
  }
  .newsletter-embed .main-form .emailoctopus-form-row {
    flex: 1;
    margin: 0 !important;
  }
  .newsletter-embed .main-form input[type='submit'] {
    margin: 0 !important;
  }
  .newsletter-embed input.form-control {
    height: 42px;
    width: 100%;
    border-radius: 10px !important;
    border: 1px solid var(--color-border) !important;
    background: var(--color-ink) !important;
    color: var(--color-cream) !important;
    padding-inline: 14px;
    font-size: 14px;
    font-family: 'Inter', system-ui, sans-serif;
    box-shadow: none !important;
  }
  .newsletter-embed input.form-control::placeholder {
    color: var(--color-muted);
  }
  .newsletter-embed input.form-control:focus {
    outline: none;
    border-color: var(--color-gold);
  }
  .newsletter-embed input[type='submit'].btn {
    width: auto !important;
    height: 42px;
    flex: none;
    margin-bottom: 0 !important;
    border-radius: 10px !important;
    border: none !important;
    background: var(--color-gold) !important;
    color: var(--color-ink) !important;
    font-weight: 800 !important;
    font-size: 14px;
    padding-inline: 20px;
    cursor: pointer;
    box-shadow: none !important;
  }
  .newsletter-embed input[type='submit'].btn:hover {
    background: color-mix(in srgb, var(--color-gold) 85%, white) !important;
  }
  .newsletter-embed .emailoctopus-form-row-hp {
    display: none;
  }
  .newsletter-embed [eo-block='powered-by'] {
    display: none !important;
  }
</style>
