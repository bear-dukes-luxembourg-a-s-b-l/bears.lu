---
import Icon from './Icon.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/bear-pride', label: 'Bear Pride' },
  { href: '/mr-bear', label: 'Mr Bear' },
  { href: '/news', label: 'News' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-10 border-b border-border-soft bg-ink/90 backdrop-blur-sm">
  <div class="mx-auto flex h-[76px] max-w-[1240px] items-center justify-between px-8">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.png" alt="Bear Dukes Luxembourg" class="h-11 w-auto" />
      <span class="font-display text-[18px] leading-none">
        Bear Dukes<br />
        <span class="text-[11px] tracking-[2px] text-tan normal-case font-sans font-normal">LUXEMBOURG</span>
      </span>
    </a>
    <nav class="hidden items-center gap-8 text-sm font-semibold text-[#D9CFC0] md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class={item.href === currentPath ? 'text-gold' : ''}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-[18px]">
      <div class="flex items-center gap-1 text-xs font-bold text-tan">
        <span class="text-gold">EN</span><span class="opacity-40">·</span><span>FR</span><span class="opacity-40">·</span><span>DE</span>
      </div>
      <a
        href="https://shop.bears.lu/"
        class="inline-flex items-center gap-2 rounded-full border-2 border-cream px-5 py-2.5 text-[13px] font-bold text-cream"
      >
        <Icon name="bag" /> Shop
      </a>
    </div>
  </div>
</header>
