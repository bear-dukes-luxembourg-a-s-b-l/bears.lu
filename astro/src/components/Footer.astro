      <a href="#" class="inline-flex items-center gap-1.5"><Icon name="ig" /> Instagram</a>
      <a href="https://shop.bears.lu/" class="inline-flex items-center gap-1.5"><Icon name="bag" /> Shop</a>
      <a href="/contact">Contact</a>
