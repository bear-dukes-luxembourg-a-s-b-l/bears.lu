---
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'generalEvents'>['data'];
  /** Alternates the day badge between the rust and dark style; community
   * events always get the dark one regardless of this. */
  index: number;
}

const { event, index } = Astro.props;

const monthShort = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en', { month: 'short' });
const dayNumber = (iso: string) => new Date(`${iso}T00:00:00`).getDate();

// A single-day event with a fixed start time shows that time. A multi-day
// one (most community events) shows its date span instead, derived from
// end_date rather than stored as free text.
const dateRange = (startIso: string, endIso: string) => {
  const start = new Date(`${startIso}T00:00:00`);
  const end = new Date(`${endIso}T00:00:00`);
  const sameMonth = start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear();
  return sameMonth
    ? `${start.getDate()}–${end.getDate()} ${monthShort(startIso)}`
    : `${start.getDate()} ${monthShort(startIso)} – ${end.getDate()} ${monthShort(endIso)}`;
};

const when =
  event.time ?? (event.end_date && event.end_date !== event.date ? dateRange(event.date, event.end_date) : null);

const dark = event.community || index % 2 === 1;
---
<div
  class="flex items-center gap-4 rounded-2xl border border-border bg-surface p-4"
  data-lat={event.coordinates?.lat}
  data-lon={event.coordinates?.lon}
>
  <div
    class:list={[
      'flex h-[60px] w-[60px] flex-none flex-col items-center justify-center rounded-xl',
      dark ? 'border border-border bg-ink' : 'bg-rust',
    ]}
  >
    <span class="text-xl font-extrabold leading-none">{dayNumber(event.date)}</span>
    <span class:list={['text-[10px] font-bold uppercase tracking-wide', dark ? 'text-tan' : 'text-gold-pale']}>
      {monthShort(event.date)}
    </span>
  </div>
  <div class="min-w-0 flex-1">
    <div class="truncate text-base font-bold">{event.title}</div>
    <div class="text-sm text-tan">
      {when && <>{when} · </>}{event.place}
      {event.coordinates && <span data-distance></span>}
    </div>
  </div>
  {event.community ? (
    <span class="flex-none rounded-full border border-tan px-2.5 py-1 text-xs font-bold text-tan">Community</span>
  ) : (
    event.price && (
      <span class="flex-none rounded-full border border-blue-flag px-2.5 py-1 text-xs font-bold text-blue-flag">
        {event.price}
      </span>
    )
  )}
</div>
